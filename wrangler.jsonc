{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sixteen-bed-limit",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },

  // The three AI routes are unauthenticated and call a metered service, so
  // they are the site's only real abuse/cost surface. Keyed per client IP.
  // `period` accepts only 10 or 60 (Cloudflare rate-limit binding).
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "MEDIA_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "vars": {
    "SITE_ORIGIN": "https://16bedlimit.com"
  }
}
