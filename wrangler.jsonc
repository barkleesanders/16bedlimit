{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sixteen-bed-limit",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },

  // Serves public/ as static assets — currently the one accountability report
  // PDF. Assets are matched BEFORE the Worker, so anything added under public/
  // silently shadows a Worker route of the same path. Both handling modes are
  // pinned rather than left to their defaults, because the defaults are what
  // would break the site:
  //   html_handling "none"      — no index.html / trailing-slash rewriting, so
  //                               a future public/index.html cannot take over
  //                               GET / from the SSR handler.
  //   not_found_handling "none" — a request that matches no asset falls
  //                               through to the Worker instead of being
  //                               answered by the asset router.
  // No `binding` is declared: the Worker never fetches assets itself, and an
  // unused binding would just be one more thing to keep true.
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Custom domain is canonical. workers_dev is turned off here AND via the
  // CF API — a deploy does not disengage an already-enabled subdomain from
  // config alone, and it silently re-opens the preview hostname each time.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "16bedlimit.com", "custom_domain": true },
    { "pattern": "www.16bedlimit.com", "custom_domain": true }
  ],

  // The three AI routes are unauthenticated and call a metered service, so
  // they are the site's only real abuse/cost surface. Keyed per client IP.
  // `period` accepts only 10 or 60 (Cloudflare rate-limit binding).
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "MEDIA_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Weekly. Agencies publish these annually, so anything tighter is pure noise
  // against three upstream servers. Sunday 06:15 UTC — deliberately off the
  // hour, since :00 is where every cron on the platform piles up.
  //
  // The weekday is 1, not 0. Cloudflare's cron parser numbers weekdays 1-7 with
  // 1 = Sunday, unlike standard cron's 0-6 with 0 = Sunday. A "0" here is
  // rejected outright at deploy time with "invalid cron string" — which is the
  // good failure. The dangerous edit is changing this to a plain-cron weekday
  // that happens to be in range: "* * 5" would silently mean Thursday here.
  "triggers": {
    "crons": ["15 6 * * 1"]
  },

  // Holds the freshness REPORT only. No figure on this site is ever written
  // from a scrape — see src/freshness.ts for the reasoning.
  "kv_namespaces": [
    {
      "binding": "FRESHNESS",
      "id": "da59ddc80ab14615822b13bad2eaf30f"
    }
  ],

  "vars": {
    "SITE_ORIGIN": "https://16bedlimit.com"
  }
}
