{
  "name": "sixteen-bed-limit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.jsonc --env=\"\"",
    "build": "wrangler deploy --dry-run --config ./wrangler.jsonc --env=\"\" --outdir=dist",
    "check": "npm run build",
    "gate:release": "npm run lint && npm run typecheck && npm test && npm audit",
    "gate:release:enforcement": "node scripts/stt-cache-enforcement.mjs",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe:constrained": "node tests/probe-constrained.mjs probe"
  },
  "dependencies": {
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^22.20.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
